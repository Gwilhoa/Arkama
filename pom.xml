<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>fr.guigui205.arkama</groupId>
  <artifactId>Arkama</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <name>Arkama</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>8</maven.compiler.source>
    <maven.compiler.target>8</maven.compiler.target>
    <nanohttpd.version>2.3.1</nanohttpd.version>
  </properties>

  <repositories>
    <repository>
      <id>papermc</id>
      <url>https://papermc.io/repo/repository/maven-public/</url>
    </repository>
  </repositories>

  <dependencies>
    <!-- Paper API -->
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>1.21.3-R0.1-SNAPSHOT</version>
      <scope>provided</scope>
    </dependency>

    <!-- NanoHTTPD -->
    <dependency>
      <groupId>org.nanohttpd</groupId>
      <artifactId>nanohttpd</artifactId>
      <version>${nanohttpd.version}</version>
      <scope>compile</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Compiler Plugin -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.8.1</version>
        <configuration>
          <source>8</source>
          <target>8</target>
        </configuration>
      </plugin>

      <!-- Shade Plugin to include NanoHTTPD in the final JAR -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.2.4</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <relocations>
                <relocation>
                  <pattern>fi.iki.elonen</pattern>
                  <shadedPattern>fr.guigui205.shaded.nanohttpd</shadedPattern>
                </relocation>
              </relocations>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <modules>
    <module>data/Arkama-Core</module>
    <module>data/Arkama-Old</module>
    <module>data/ArkaHome</module>
    <module>data/ArkaTeleport</module>
    <module>data/ArkaHammer</module>
    <module>data/ArkaGamemode</module>
    <module>data/ArkaTP</module>
    <module>data/ArkaWarp</module>
    <module>data/ArkaWands</module>
    <module>data/ArkaGrades</module>
    <module>data/ArkaChat</module>
    <module>data/ArkaMultiverse</module>
    <module>data/ArkaTabList</module>
    <module>data/ArkaEnchant</module>
    <module>data/ArkaUtils</module>
  </modules>

</project>
